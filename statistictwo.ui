       <string notr="true">QPushButton {
    background-color: #2D2D2D;
    color: #00FF00;  /* Зеленый цвет для состояния &quot;Вкл&quot; */
    border: 1px solid #3E3E3E;
    padding: 5px;
    min-width: 150px;
    min-height: 30px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #3E3E3E;
}

QPushButton:pressed {
    background-color: #1E1E1E;
}

QPushButton:checked {
    color: #FF0000;  /* Красный цвет для состояния &quot;Выкл&quot; */
    background-color: #2D2D2D;
}

QPushButton:checked:hover {
    background-color: #3E3E3E;
}</string>
