         <property name="styleSheet">
          <string notr="true">QPushButton {
    text-align: center;
    color: white;
    border-radius: 8px;
    padding: 5px 10px;
    font-weight: bold;
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
                              stop:0 #4A4A4A, stop:0.5 #707070, stop:1 #4A4A4A);
    border: none;
    min-height: 25px;
    max-width: 150px;
}

QPushButton:hover {
    background: qlineargradient(spread:pad, x1:1, y1:0, x2:0, y2:0, 
                              stop:0 #4A4A4A, stop:0.5 #707070, stop:1 #4A4A4A);
}

QPushButton:pressed {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
                              stop:0 #303030, stop:0.5 #505050, stop:1 #303030);
}

QPushButton:disabled {
    background: #9E9E9E;
    color: #E0E0E0;
}</string>
