    <property name="styleSheet">
     <string notr="true">QProgressBar {
    background-color: #f0f0f0;               /* Светлый фон */
    border: 1px solid #696969;               /* Светло-серая граница */
    border-radius: 10px;                     /* Закругленные края */
    text-align: center;                      /* Центрирование текста */
    font-size: 12px;                         /* Размер шрифта */
    color: #555555;                          /* Темный цвет текста */
    min-height: 25px;                        /* Высота прогресс-бара */
}

QProgressBar::chunk {
    background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 #d0d0d0, stop:1 #696969);     /* Матовый серый градиент */
    border-radius: 8px;                      /* Закругленные края сегмента */
    margin: 2px;                             /* Отступы от краев */
}
</string>
