   <widget class="QPushButton" name="disconnectButton">
    <property name="geometry">
     <rect>
      <x>690</x>
      <y>310</y>
      <width>100</width>
      <height>35</height>
     </rect>
    </property>
    <property name="styleSheet">
     <string notr="true">QPushButton {
    text-align: center;
    color: #FF3333;  /* Улучшенный оттенок красного для лучшей видимости */
    border-radius: 8px;
    padding: 5px 10px;
    font-weight: bold;
    /* Более темный фон для лучшего контраста с красным текстом */
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
                              stop:0 #3D3D3D, stop:0.5 #505050, stop:1 #3D3D3D);
    border: none;
    min-height: 25px;
    min-width: 80px;
    max-width: 150px;
    font-size: 13px;
    /* Добавляем тень текста для резкости */
    text-shadow: 0px 0px 1px rgba(0, 0, 0, 0.8);
    letter-spacing: 0.5px;
}

QPushButton:hover {
    color: #FF4D4D; /* Чуть светлее при наведении для обратной связи */
    background: qlineargradient(spread:pad, x1:1, y1:0, x2:0, y2:0, 
                              stop:0 #454545, stop:0.5 #5A5A5A, stop:1 #454545);
}

QPushButton:pressed {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
                              stop:0 #303030, stop:0.5 #404040, stop:1 #303030);
    color: #FF1A1A;  /* Немного более темный красный при нажатии */
}

QPushButton:disabled {
    background: #7E7E7E; /* Более темный серый для отключенного состояния */
    color: #FFACAC;  /* Улучшенный бледно-красный для лучшей видимости */
    text-shadow: none; /* Убираем тень для отключенного состояния */
}</string>
    </property>
    <property name="text">
     <string>ВЫХОД</string>
    </property>
