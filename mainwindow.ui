   <property name="styleSheet">
    <string notr="true">QMenuBar {
    background-color: #1E1E1E;
    color: #D4D4D4;
    border-bottom: 1px solid #2D2D2D;
}
QMenuBar::item {
    padding: 8px 12px;
    background: transparent;
}
QMenuBar::item:selected {
    background-color: #2D2D2D;
    border-radius: 4px;
}
QMenuBar::item:pressed {
    background-color: #3D3D3D;
}
QMenu {
    background-color: #1E1E1E;
    color: #D4D4D4;
    border: 1px solid #2D2D2D;
    border-radius: 4px;
    padding: 5px;
    margin: 2px;
}
QMenu::item {
    padding: 8px 25px 8px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #2D2D2D;
}
QMenu::item:pressed {
    background-color: #3D3D3D;
}
QMenu::separator {
    height: 1px;
    background: #2D2D2D;
    margin: 5px 10px;
}
QMenu::indicator {
    width: 18px;
    height: 18px;
}</string>
