  <widget class="QDateEdit" name="startDateEdit">
   <property name="geometry">
    <rect>
     <x>10</x>
     <y>50</y>
     <width>121</width>
     <height>34</height>
    </rect>
   </property>
   <property name="styleSheet">
    <string notr="true">QDateEdit {
    background-color: #EFEFEF; /* Цвет фона */
    color: #000000; /* Цвет текста (черный) */
    border: 1px solid #C2C2C2; /* Цвет границы */
    border-radius: 6px; /* Закругление углов */
    padding: 6px 10px; /* Отступы внутри */
    min-height: 20px; /* Минимальная высота */
    font-size: 13px; /* Размер шрифта */
}

QDateEdit:hover {
    background-color: #E5E5E5; /* Цвет фона при наведении */
    border: 1px solid #A0A0A0; /* Цвет границы при наведении */
}

QDateEdit:focus {
    border: 1px solid #808080; /* Цвет границы при фокусе */
    background-color: #FAFAFA; /* Цвет фона при фокусе */
}

QDateEdit::drop-down {
    subcontrol-origin: padding; /* Положение кнопки */
    subcontrol-position: center right; /* Положение кнопки */
    width: 22px; /* Ширина кнопки */
    border-left: none; /* Убираем границу слева */
    margin-right: 6px; /* Отступ справа */
}

QDateEdit::down-arrow {
    image: url(resources/arrow-down.png); /* Изображение стрелки вниз */
    width: 12px; /* Ширина стрелки */
    height: 12px; /* Высота стрелки */
}

QDateEdit::up-button, QDateEdit::down-button {
    background-color: #EFEFEF; /* Цвет фона кнопок */
    border: none; /* Убираем границу */
    width: 22px; /* Ширина кнопок */
}

QDateEdit::up-button:hover, QDateEdit::down-button:hover {
    background-color: #E5E5E5; /* Цвет фона кнопок при наведении */
}

QDateEdit::up-button:pressed, QDateEdit::down-button:pressed {
    background-color: #D0D0D0; /* Цвет фона кнопок при нажатии */
}

QDateEdit::up-button:disabled, QDateEdit::down-button:disabled {
    background-color: #D9D9D9; /* Цвет фона кнопок при отключении */
}</string>
   </property>
