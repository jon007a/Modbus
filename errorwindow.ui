   </property>
   <property name="styleSheet">
    <string notr="true">QTableWidget {
    background-color: #FFFFFF; /* Цвет фона таблицы */
    color: #404040; /* Цвет текста */
    border: 1px solid #C2C2C2; /* Цвет границы */
    border-radius: 6px; /* Закругление углов */
}

QTableWidget::item {
    padding: 8px; /* Отступы внутри ячеек */
}

QTableWidget::horizontalHeader {
    background-color: #4A4A4A; /* Цвет фона заголовков */
    color: white; /* Цвет текста заголовков */
    border: none; /* Убираем границу */
    font-weight: bold; /* Жирный шрифт для заголовков */
}

QTableWidget::verticalHeader {
    background-color: #F0F0F0; /* Цвет фона вертикальных заголовков */
    color: #404040; /* Цвет текста вертикальных заголовков */
    border: none; /* Убираем границу */
}

QTableWidget::horizontalHeader::section {
    padding: 10px; /* Отступы внутри заголовков */
}

QTableWidget::item:selected {
    background-color: #A0A0A0; /* Цвет фона выбранной ячейки */
    color: white; /* Цвет текста выбранной ячейки */
}

QTableWidget::item:hover {
    background-color: #E5E5E5; /* Цвет фона ячейки при наведении */
}

QTableWidget::verticalHeader::section {
    background-color: #E5E5E5; /* Цвет фона для вертикальных заголовков */
    border: 1px solid #C2C2C2; /* Цвет границы для вертикальных заголовков */
}</string>
