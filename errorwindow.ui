   <property name="styleSheet">
    <string notr="true">QPushButton {
    text-align: center;
    color: white;
    border-radius: 8px;
    padding: 5px 10px;
    font-weight: bold;
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
                              stop:0 #3A3A3A, stop:0.5 #606060, stop:1 #3A3A3A);
    border: none;
    min-height: 20px;
    max-width: 150px;
}

QPushButton:hover {
    background: qlineargradient(spread:pad, x1:1, y1:0, x2:0, y2:0, 
                              stop:0 #2A2A2A, stop:0.5 #404040, stop:1 #2A2A2A) /* Темнее при наведении */
}

QPushButton:pressed {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
                              stop:0 #1F1F1F, stop:0.5 #303030, stop:1 #1F1F1F);
}

QPushButton:disabled {
    background: #9E9E9E;
    color: #E0E0E0;
}</string>
